# Backend / FastAPI
APP_ENV=development
PORT=8000
LOG_LEVEL=INFO

# PostgreSQL existente
DATABASE_URL=postgresql+psycopg2://USUARIO:CONTRASENA@HOST:5432/BASE_DE_DATOS
# Alternativa por variables separadas:
# DB_USER=
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=

# Seguridad
JWT_SECRET=CAMBIA_ESTA_CLAVE_POR_UNA_LARGA_Y_ALEATORIA
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
BCRYPT_ROUNDS=12

# Red / frontend
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# En producción: ALLOWED_HOSTS=api.tudominio.com
ALLOWED_HOSTS=

# Pool PostgreSQL
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=5

# Frontend opcional
VITE_API_URL=http://127.0.0.1:8000

# Servicios opcionales
GEMINI_API_KEY=
